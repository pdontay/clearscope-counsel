# Copy this file to .env and fill in real values. Never commit .env.

# --- OpenRouter (Research Agent + Voice Agent) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any model slug from https://openrouter.ai/models. Pick something strong for
# drafting; research extraction can use a cheaper one if you split the two.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Gmail (sending drafts + polling for your yes/no/revision replies) ---
# Create at https://myaccount.google.com/apppasswords (requires 2FA enabled).
# Use a dedicated Gmail account if you don't want this living in your personal inbox.
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_EMAIL=dontayphillips@gmail.com

# --- Publishing (git push to the site repo on approval) ---
# Absolute path to a local clone of pdontay/clearscope-counsel on this VPS.
# The git credential helper or SSH deploy key for this clone must already be
# configured — this script only runs `git add/commit/push`, it doesn't set up auth.
GIT_REPO_PATH=/home/deploy/clearscope-counsel

# --- Misc ---
# SQLite file tracking seen feed items, drafts, and email threads.
STATE_DB_PATH=/home/deploy/tracker-agent/state.db
