# Copy this file to .env and fill in real values. Never commit .env.

# --- OpenRouter (Research Agent + Voice Agent) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Primary is tried first; llm.py automatically falls back to secondary on any
# failure (rate limit, outage, a slug getting deprecated). Any slug from
# https://openrouter.ai/models works — verify it's still listed before
# changing these, model names get retired without much notice.
PRIMARY_MODEL=google/gemini-3.6-flash
SECONDARY_MODEL=openai/gpt-4o-mini

# --- Sending drafts + polling for your yes/no/revision replies ---
# EMAIL_ADDRESS/PASSWORD is the mailbox the agent logs into (SMTP to send,
# IMAP to poll for your replies). NOTIFY_EMAIL is where drafts get sent TO —
# your reply lands back in EMAIL_ADDRESS's inbox, which is what gets polled.
EMAIL_ADDRESS=marketing@clearscopecounsel.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_EMAIL=dontayphillips@gmail.com

# Defaults below are Hostinger's webmail servers (correct for any
# @clearscopecounsel.com mailbox). Override only if EMAIL_ADDRESS is on a
# different provider (e.g. Gmail: smtp.gmail.com/465, imap.gmail.com/993,
# with a Google App Password instead of the account password).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# --- Publishing (git push to the site repo on approval) ---
# Absolute path to a local clone of pdontay/clearscope-counsel on this VPS.
# The git credential helper or SSH deploy key for this clone must already be
# configured — this script only runs `git add/commit/push`, it doesn't set up auth.
GIT_REPO_PATH=/home/deploy/clearscope-counsel

# --- Misc ---
# SQLite file tracking seen feed items, drafts, and email threads.
STATE_DB_PATH=/home/deploy/tracker-agent/state.db
