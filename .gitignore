# Design review / working source files (large, not part of the site)
Binder1.pdf
Website Design Review*.html

# Build artifact / raw source photos (regenerate zip on demand, not versioned)
/clearscope-site-upload.zip
/Photos/

# Article drafts. The published page is the artifact; the source Markdown is
# working material and has no business on the web server.
/finra-expungement-article-revised.md

# Raw generation sources (~148MB of mp4/png) that assets/media/ derivatives are
# built from via assets/generated-media/build-derivatives.sh. Nothing on the site
# links to them, and the Hostinger rsync has no exclude for assets/, so tracking
# these would publish the raw masters and bloat every deploy.
/assets/generated-media/

# Agent tooling and working notes. None of it is site content, and the deploy
# rsync only excludes .git/, .github/, .claude/, tracker-agent/ and worker/ —
# anything else tracked here would be served publicly.
/.agents/
/.impeccable/
/design-research/
/scripts/
/skills-lock.json
/.claude/skills/

