# ClearScope Counsel — static hosting config (Apache / Hostinger)
# Addresses PageSpeed "efficient cache lifetimes" + Best Practices "Trust and Safety".

# ----------------------------------------------------------------------
# 1) Cache lifetimes for static assets (speeds up repeat visits)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType image/gif                "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  # Scroll-triggered b-roll in assets/media — fetched once, then cached.
  ExpiresByType video/mp4                "access plus 1 year"
  ExpiresByType video/webm               "access plus 1 year"
  # HTML stays short so content updates show up promptly.
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived, immutable cache for fingerprint-free static assets.
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # Always revalidate HTML so edits go live immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Word forms in /downloads/ are third-party licensed documents served
  # unchanged. Declare the real type so browsers save rather than mangle them,
  # and force an attachment so a click downloads instead of handing the file to
  # an in-browser viewer that could re-save it altered.
  <FilesMatch "^.*\.docx$">
    Header set Content-Type "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    Header set Content-Disposition "attachment"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # llms.txt is Markdown despite the .txt name. Apache serves it as text/plain,
  # and because we also send X-Content-Type-Options: nosniff, nothing is allowed
  # to infer otherwise — so tooling that expects Markdown (Lighthouse's llms.txt
  # audit among them) rejects an otherwise valid file. Declare the real type.
  <Files "llms.txt">
    Header set Content-Type "text/markdown; charset=utf-8"
  </Files>

  # --------------------------------------------------------------------
  # 2) Trust and Safety headers
  # --------------------------------------------------------------------
  # Force HTTPS for a year (only enable once HTTPS is confirmed working).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Stop MIME-type sniffing.
  Header always set X-Content-Type-Options "nosniff"
  # Clickjacking protection — others may not frame this site.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Limit referrer leakage.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Trim powerful-feature access.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Content-Security-Policy — left commented intentionally.
  # A real policy must allow: Cal.com (app.cal.com), Formspree (formspree.io),
  # Google Fonts (fonts.googleapis.com / fonts.gstatic.com), and inline scripts
  # ('unsafe-inline' or nonces). Enable only after testing the booking embed,
  # the contact form, fonts, and the theme toggle on a staging copy.
  # Header always set Content-Security-Policy "default-src 'self'; ..."
</IfModule>

# Chrome Private Prefetch Proxy — serve /.well-known/traffic-advice with the
# MIME type Googlebot's prefetch-proxy expects, avoiding spurious 404s.
# https://developer.chrome.com/blog/private-prefetch-proxy/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/traffic-advice$ - [T=application/trafficadvice+json,END]

  # Canonical host. www served the identical page at 200 rather than
  # redirecting, so every URL on the site existed twice for crawlers. The
  # canonical tags already pointed at the apex, but a 301 is what actually
  # collapses the duplicate.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Canonical homepage. / and /index.html both returned 200. THE_REQUEST is
  # matched rather than the path, because DirectoryIndex rewrites / to
  # index.html internally and matching the rewritten path would loop.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Legacy root guide URLs -> canonical /resources/ locations
Redirect 301 /broker-dealer-vs-investment-adviser.html /resources/broker-dealer-vs-investment-adviser.html
Redirect 301 /missouri-business-entity-selection.html /resources/missouri-business-entity-selection.html
Redirect 301 /startup-legal-launch-checklist.html /resources/startup-legal-launch-checklist.html

# Retired practice areas (2026 repositioning: startup counsel + FINRA compliance consulting)
Redirect 301 /estate-planning.html /
Redirect 301 /eeoc-charge-support.html /
Redirect 301 /small-business-counsel.html /startup-counsel.html

# Retired AI Influencer Discovery tool (product-tour UI unrelated to the practice of law)
Redirect 301 /influencer-discovery.html /startup-counsel.html

# Retired Website Compliance Scan tool (same product-tour anti-pattern, no matching self-serve product)
Redirect 301 /website-compliance-scan.html /resources.html

# Retired FINRA compliance-for-firms consulting (2026 repositioning: claimant-side FINRA
# arbitration + investor recovery replaces compliance consulting; expungement is now its
# own flat-fee offering on finra-securities.html, not a firm-facing consulting guide)
Redirect 301 /finra-compliance-readiness-checklist.html /resources.html
Redirect 301 /resources/finra-compliance-readiness-checklist.html /resources.html
Redirect 301 /resources/finra-3270-oba-review-for-registered-reps.html /resources.html
# Rule 4530 is deliberately NOT retired: the guide was rewritten and relinked
# from resources.html and sitemap.xml in August 2026. Redirecting it here would
# send its own index card straight back to the index it links from.

# Orphaned scripts from the two retired tools above. Their pages 301 away, but
# the deploy rsync runs without --delete, so the files themselves stay on the
# server and kept answering 200 — including creator-catalog.js, ~147KB of
# creator data from a product that no longer exists. 410 rather than 301
# because these are assets, not pages: nobody should be redirected to a
# document when the thing they asked for is simply gone. Removing the files in
# the Hostinger File Manager would make these lines unnecessary.
Redirect gone /creator-catalog.js
Redirect gone /influencer-discovery.js
Redirect gone /search-config.js
Redirect gone /site-scan-config.js

# Retired guides -> resource library
Redirect 301 /missouri-estate-planning-checklist.html /resources.html
Redirect 301 /will-vs-trust-missouri.html /resources.html
Redirect 301 /eeoc-charge-process-what-to-expect.html /resources.html
Redirect 301 /small-business-legal-health-audit.html /resources.html
Redirect 301 /resources/missouri-estate-planning-checklist.html /resources.html
Redirect 301 /resources/will-vs-trust-missouri.html /resources.html
Redirect 301 /resources/eeoc-charge-process-what-to-expect.html /resources.html
Redirect 301 /resources/small-business-legal-health-audit.html /resources.html
